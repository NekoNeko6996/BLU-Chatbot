#=========================================================== admin-server.py ===========================================================
# ========== CẤU HÌNH GEMINI PHÂN TÍCH ẢNH ==========
# Điền API Key của bạn vào đây
GEMINI_API_KEY=thay_api_key_cua_ban_vao_day

# URL của model Gemini (Mặc định đang dùng gemini-3.1-flash-lite-preview)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-preview:generateContent

# Công tắc bật/tắt AI phân tích ảnh: "true" để chạy AI, "false" để trả về Fallback an toàn
ENABLE_GEMINI_VISION=false

#=========================================================== serverBL.py (Chatbot engine server) ===========================================================
# ========== CẤU HÌNH GG SHEET LƯU INFO NGƯỜI DÙNG VÀ LỊCH SỬ CHAT ==========
# save user info and chat history to gg sheet
GOOGLE_SHEETS_CRED_FILE=google_credentials.json
GOOGLE_SPREADSHEET_ID=15hXxWkPy3NurIBdBcVy3M_E0GKCH4utPt4cxPMLwDo0

# ========== CẤU HÌNH API KEY CHO API VÀ CLIENT ==========
PUBLIC_API_KEY=QA67V0pMzb2kLlSYQe7mPyJxGlKnbWaKVya2EZNFxtF16Nt29WNYPjQrNShtD6ft
ADMIN_API_KEY=XN39rEZfJj9g6wRZuHHm9Qcqk8Zy0H35VAzfDKfi5sGfphZj3nlsNPIVTR5ptuGZ

# ========== CẤU HÌNH BẢO MẬT & CORS CHO FRONTEND ==========
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST
CORS_ALLOW_HEADERS=*

# ========== CẤU HÌNH THÔNG BÁO LỖI ==========
RATE_LIMIT_ERROR_MSG="Bạn đang sống vội quá, vui lòng chờ trong giây lát rồi thử lại!"

# ========== CẤU HÌNH THÔNG SỐ RAG & LLM (LOCAL - DEFAULT) ==========
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_API_BASE=http://localhost:8080/v1
LLM_API_KEY=EMPTY

# ========== CẤU HÌNH EXTERNAL LLM (TÙY CHỌN - SẼ ƯU TIÊN CHẠY TRƯỚC NẾU ĐƯỢC CÀI ĐẶT) ==========
# Nếu để trống EXTERNAL_LLM_API_KEY, hệ thống sẽ tự động chỉ dùng Local LLM
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
EXTERNAL_LLM_MODEL_NAME=gemini-3.1-flash-lite-preview

# ========== THÔNG SỐ CHUNG CHO AI ==========
LLM_TEMPERATURE=0
LLM_TOP_P=0.1
LLM_MAX_TOKEN_RESPONSE=2048

# ========== CẤU HÌNH VECTOR STORE DATABASE ==========
DATABASE_PATH=database/collection
COLLECTION_NAME=blu

# ========== EMBENDDING ==========
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
KEEP_SEPARATOR=true

# cpu || cuda || cuda:0
EMBENDDING_MODEL_KWARGS_DEVICE=cpu


# ========== RETRIEVER ==========
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MAX_CHAT_HISTORY=4
DEFAULT_RERANK_TOP_N=3
DEFAULT_SCORE_THRESHOLD=0.4
SEARCH_KWARGS=15
MAX_CHAT_RESPONSE_TOKEN=2048

# cpu || cuda || cuda:0
RETRIEVER_MODEL_KWARGS_DEVICE=cpu

#=========================================================== daily_report.py (Script báo cáo tự động) ===========================================================
